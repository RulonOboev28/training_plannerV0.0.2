  "annual": {
    "id": "07eadc57",
    "title": "Персональная программа тренировок v1.0",
    "pos_x": 0.0,
    "pos_y": 0.0,
    "notes": "Программа из блокнота «Персональная программа тренировок». Инвентарь: гантели до 2×12,5 кг, турник, брусья, резинки, диван. Первые две недели — вводные. Главная задача — регулярность.",
    "connections": [],
    "year": 2026,
    "sport_type": "Силовой тренинг / домашний зал",
    "macrocycles": [
      {
        "id": "18e0b536",
        "title": "Летний блок — рекомпозиция",
        "pos_x": 0.0,
        "pos_y": 0.0,
        "notes": "Первый мезоцикл программы рекомпозиции тела.",
        "connections": [],
        "duration_months": 1,
        "mesocycles": [
          {
            "id": "f7b2fce0",
            "title": "Рекомпозиция — вводный блок (2 недели)",
            "pos_x": 0.0,
            "pos_y": 0.0,
            "notes": "Персональная программа v1.0. 24 года, 189 см, 86 кг. Цель: снижение жира до 14–16% с набором мышечной массы. Частота: Пн/Ср/Пт — силовая; Вт/Чт/Сб — велосипед 40–60 мин, пульс 120–140; Вс — отдых. Разминка 10 мин + основная часть 60–75 мин + пресс 10 мин. Белок ≈170 г/день, вода 3 л, креатин 5 г/день, сон 7,5–9 ч. Прогрессия: верхняя граница повторений во всех подходах → +2 кг. Цикл рассчитан минимум на 8–12 недель (чередование недель 1 и 2).",
            "connections": [],
            "cycle_type": "Втягивающий",
            "duration_weeks": 2,
            "microcycles": [
              {
                "id": "980c7fef",
                "title": "Микроцикл 1 — Неделя №1 (вводная)",
                "pos_x": 0.0,
                "pos_y": 0.0,
                "notes": "Вводный микроцикл. Цель — привычка и техника, не максимум. Силовые: 6, 8, 10 июля. Воскресенье 12 июля — отдых. Между силовыми днями — велосипед (вт, чт, сб) по программе блокнота.",
                "connections": [
                  {
                    "target_id": "c45b62a3",
                    "kind": "sequence"
                  }
                ],
                "cycle_type": "Втягивающий",
                "duration_days": 7,
